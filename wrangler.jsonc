{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "keycraft-5000",
	"main": "worker/integrated.ts",
	"compatibility_date": "2026-10-01",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		"not_found_handling": "single-page-application",
		"run_worker_first": [
			"/api/*"
		]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "keycraft-5000-db",
			"database_id": "d8fdeccc-6d62-4353-823d-e0bcd2eedc9f",
			"migrations_dir": "./migrations"
		}
	],
	"kv_namespaces": [
		{
			"binding": "DELIVERABLES_KV",
			"id": "5c4b3d9ba160418fa91f12a5d6edb2b9"
		},
		{
			"binding": "CHARACTERS_KV",
			"id": "63888054116b4a73885ed61a34164dae"
		}
	],
	"services": [
		{
			"binding": "SAI_COIN",
			"service": "sai-coin"
		}
	],
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1
	}
}
